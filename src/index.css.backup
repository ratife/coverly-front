/* Styles globaux - Tailwind est chargé via CDN dans index.html */
body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  font-family: 'Space Grotesk', sans-serif;
}

/* Animation pour les entrées */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-in {
  animation: fadeIn 0.5s ease-out;
}

/* Classes utilitaires personnalisées */
.pro-glow {
  box-shadow: 0 0 20px rgba(75, 43, 238, 0.3);
}

.glass-effect {
  backdrop-filter: blur(8px);
  background: rgba(30, 25, 51, 0.6);
}

.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: #4b2bee;
  border-radius: 3px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #3a1fd8;
}

.mesh-gradient {
  background: linear-gradient(135deg, #f6f6f8 0%, #eef1f5 100%);
}

.dark .mesh-gradient {
  background: linear-gradient(135deg, #0a0a0f 0%, #131022 100%);
}